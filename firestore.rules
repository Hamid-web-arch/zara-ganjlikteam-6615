rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Siyahıların hər kəs tərəfindən oxunmasına icazə ver
    match /staff/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /crew/{document=**} { allow read: if true; allow write: if request.auth != null; }
    
    // Digər xüsusi bölmələr
    match /settings/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /approved_moments/{document=**} { allow read: if true; allow write: if request.auth != null; }

    // Qalan hər şey üçün yalnız admin icazəlidir
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}